<Window x:Class="Crest.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Crest.Controls"
        Title="Crest" Width="720" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Fg}">

    <Grid>
        <!-- Soft shadow under the island (same outline, drawn separately so the island can clip) -->
        <!-- Cached, so the big soft shadow is drawn once per shape change, not every frame. -->
        <Grid IsHitTestVisible="False">
            <Grid.CacheMode>
                <BitmapCache RenderAtScale="0.5" />
            </Grid.CacheMode>
            <Path x:Name="ShadowShape" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Fill="#000000" Opacity="0" IsHitTestVisible="False">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.6" Color="#000000" />
                </Path.Effect>
            </Path>
        </Grid>

        <Grid x:Name="Island" HorizontalAlignment="Left" VerticalAlignment="Top" Width="720" Height="300"
              MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
              MouseLeftButtonUp="Island_Click">

            <!-- The body: black glass with concave shoulders that melt into the screen edge -->
            <Path x:Name="IslandShape" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Path.Fill>
                    <SolidColorBrush Color="#000000" />
                </Path.Fill>
                <Path.Stroke>
                    <LinearGradientBrush x:Name="RimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#08FFFFFF" Offset="0.5" />
                        <GradientStop Color="#2EFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>

            <Grid x:Name="IslandContent" HorizontalAlignment="Left" VerticalAlignment="Top" Width="720" Height="300">

                <!-- ========== LIQUID GLASS: the screen behind, frosted, bent at the edge (set up in code) ========== -->
                <Grid x:Name="Glass" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Width="720" Height="360">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="GlassShift" />
                    </Grid.RenderTransform>
                    <Image x:Name="GlassImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" />
                </Grid>

                <!-- ========== ARTWORK BACKDROP: the cover, melted into light behind everything ========== -->
                <Grid x:Name="Backdrop" Opacity="0" IsHitTestVisible="False" ClipToBounds="True"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Width="620" Height="232" Margin="0,-6,0,0">
                    <Grid x:Name="BackdropArt" Margin="-80" RenderTransformOrigin="0.5,0.5">
                        <!-- The blur happens once, inside this cache; the drift below only moves the cached
                             picture, so the GPU is not re-blurring the cover every frame. It is soft, so half
                             resolution is plenty. -->
                        <Grid.CacheMode>
                            <BitmapCache RenderAtScale="0.5" />
                        </Grid.CacheMode>
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BackdropGrow" />
                                <ScaleTransform x:Name="BackdropScale" ScaleX="1.05" ScaleY="1.05" />
                                <RotateTransform x:Name="BackdropTurn" />
                                <TranslateTransform x:Name="BackdropShift" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Grid>
                            <Grid.Effect>
                                <BlurEffect x:Name="BackdropBlur" Radius="46" KernelType="Gaussian" RenderingBias="Performance" />
                            </Grid.Effect>
                            <Image x:Name="BackdropImageA" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality" />
                            <Image x:Name="BackdropImageB" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="LowQuality" />
                        </Grid>
                    </Grid>
                    <Border x:Name="BackdropScrim" />
                    <Border>
                        <Border.Background>
                            <RadialGradientBrush Center="0.18,0" GradientOrigin="0.18,0" RadiusX="0.7" RadiusY="1.1">
                                <GradientStop Color="#1FFFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- ========== COMPACT (call / idle) ========== -->
                <Grid x:Name="CompactView" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel x:Name="CallPill" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Green}">
                            <TextBlock x:Name="CallPillIcon" Style="{StaticResource Icon}" Text="&#xE720;" FontSize="11"
                                       Foreground="#000" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="CallPillTime" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Green}" VerticalAlignment="Center" Text="0:00" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="MicDot" Width="6" Height="6" Margin="6,0,0,0" Fill="{StaticResource Orange}" Visibility="Collapsed" />
                        <Ellipse x:Name="CamDot" Width="6" Height="6" Margin="4,0,0,0" Fill="{StaticResource Green}" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!-- ========== PEEK (transient activity) ========== -->
                <Grid x:Name="PeekView" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="30" Height="30" VerticalAlignment="Center">
                        <TextBlock x:Name="PeekIcon" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" />
                        <Border x:Name="PeekArt" CornerRadius="8" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="PeekArtBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="PeekSwatch" CornerRadius="15" BorderBrush="#55FFFFFF" BorderThickness="1" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PeekTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PeekSub" FontSize="11.5" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Border x:Name="PeekBarTrack" Width="120" Height="6" CornerRadius="3" Background="#33FFFFFF">
                            <Border x:Name="PeekBarFill" CornerRadius="3" Background="{StaticResource Fg}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="PeekBarScale" ScaleX="0.5" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock x:Name="PeekValue" FontSize="12" Foreground="{StaticResource FgDim}" Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- ========== EXPANDED (fixed size, revealed as the island grows) ========== -->
                <Canvas x:Name="ExpandedHost" HorizontalAlignment="Center" VerticalAlignment="Top" Width="500" Height="218">
                    <Grid x:Name="ExpandedView" Width="500" Height="218" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ExpandedScale" ScaleX="0.94" ScaleY="0.94" />
                                <TranslateTransform x:Name="ExpandedShift" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!-- Header: glass tab bar + status -->
                        <Grid Margin="16,12,14,0" VerticalAlignment="Top">
                            <Border x:Name="TabBar" HorizontalAlignment="Left" CornerRadius="16" Padding="2"
                                    Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1">
                                <Grid>
                                    <Canvas>
                                        <Border x:Name="TabDrop" Height="28" Width="34" CornerRadius="14"
                                                Background="{StaticResource GlassDrop}" BorderBrush="{StaticResource GlassDropRim}" BorderThickness="1"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="TabDropScale" />
                                            </Border.RenderTransform>
                                            <Border.Effect>
                                                <DropShadowEffect x:Name="TabDropShadow" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#000000" />
                                            </Border.Effect>
                                        </Border>
                                    </Canvas>
                                    <Grid x:Name="TabIconsHost">
                                    <StackPanel x:Name="TabIcons" Orientation="Horizontal">
                                        <RadioButton x:Name="TabHome" Style="{StaticResource GlassTab}" GroupName="tabs" Content="{StaticResource IcoMusic}" ToolTip="Now playing" IsChecked="True" Checked="Tab_Checked" />
                                        <RadioButton x:Name="TabClip" Style="{StaticResource GlassTab}" GroupName="tabs" Content="{StaticResource IcoClip}" ToolTip="Clipboard" Checked="Tab_Checked" />
                                        <RadioButton x:Name="TabControls" Style="{StaticResource GlassTab}" GroupName="tabs" Content="{StaticResource IcoControls}" ToolTip="Controls" Checked="Tab_Checked" />
                                        <RadioButton x:Name="TabSystem" Style="{StaticResource GlassTab}" GroupName="tabs" Content="{StaticResource IcoStats}" ToolTip="System" Checked="Tab_Checked" />
                                        <RadioButton x:Name="TabSettings" Style="{StaticResource GlassTab}" GroupName="tabs" Content="{StaticResource IcoGear}" ToolTip="Settings" Checked="Tab_Checked" />
                                    </StackPanel>
                                    </Grid>
                                    <!-- The lens: while a tab travels the bubble swells into clear glass that magnifies what is under it -->
                                    <Canvas IsHitTestVisible="False">
                                        <!-- The lens's shadow, blurred once into a bitmap and then only stretched and faded:
                                             a live shadow on the lens itself was re-blurred on every frame of its flight. -->
                                        <Grid x:Name="TabLensShade" Width="34" Height="28" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Grid.CacheMode>
                                                <BitmapCache />
                                            </Grid.CacheMode>
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="TabLensShadeScale" />
                                            </Grid.RenderTransform>
                                            <Border CornerRadius="14" Margin="0,3,0,-3" BorderThickness="1.5" BorderBrush="#99000000" Background="#26000000">
                                                <Border.Effect>
                                                    <BlurEffect Radius="12" />
                                                </Border.Effect>
                                            </Border>
                                        </Grid>
                                        <Border x:Name="TabLens" Height="28" Width="34" CornerRadius="14" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="TabLensScale" />
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Border CornerRadius="14" Background="#2A1C1C1E" />
                                                <Border CornerRadius="14">
                                                    <Border.Background>
                                                        <VisualBrush x:Name="TabLensBrush" Visual="{Binding ElementName=TabIcons}"
                                                                     ViewboxUnits="Absolute" Viewbox="0,0,34,28" Stretch="Fill" />
                                                    </Border.Background>
                                                </Border>
                                                <Border CornerRadius="14">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#40FFFFFF" Offset="0" />
                                                            <GradientStop Color="#0AFFFFFF" Offset="0.45" />
                                                            <GradientStop Color="#00FFFFFF" Offset="0.7" />
                                                            <GradientStop Color="#14FFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border CornerRadius="14" BorderThickness="1.5">
                                                    <Border.BorderBrush>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#B060E8FF" Offset="0" />
                                                            <GradientStop Color="#70FFFFFF" Offset="0.22" />
                                                            <GradientStop Color="#10FFFFFF" Offset="0.5" />
                                                            <GradientStop Color="#90FF5AD8" Offset="0.78" />
                                                            <GradientStop Color="#A0FFE066" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.BorderBrush>
                                                </Border>
                                                <Border CornerRadius="13" Margin="1.5" BorderThickness="0.8" BorderBrush="#33FFFFFF" />
                                            </Grid>
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel x:Name="HomeCall" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HomeCallText" Margin="5,0,0,0" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource Green}" Text="On a call" />
                                </StackPanel>
                                <TextBlock x:Name="HeaderBattery" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="ClockText" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" Text="00:00" />
                                <Button x:Name="HeaderMic" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13"
                                        Content="&#xE720;" ToolTip="Mute microphone everywhere (Ctrl+Alt+M)" Click="Mic_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- ===== Now playing (art, title, artist and waveform live in the hero layer) ===== -->
                        <StackPanel x:Name="PanelHome" Grid.Row="1" Margin="18,84,18,0">
                            <c:Scrubber x:Name="Scrub" Height="20" Margin="0,-3,0,-1" />
                            <Grid>
                                <TextBlock x:Name="PosText" FontSize="10.5" FontWeight="Medium" Foreground="{StaticResource FgDim}" Text="0:00" />
                                <TextBlock x:Name="DurText" FontSize="10.5" FontWeight="Medium" Foreground="{StaticResource FgDim}" HorizontalAlignment="Right" Text="0:00" />
                            </Grid>
                            <Grid Margin="0,-6,0,0">
                            <TextBlock x:Name="SourceText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource FgDim}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnPrev" Style="{StaticResource IconButton}" Width="42" Height="40" Click="Prev_Click">
                                    <Path Data="{StaticResource GeoPrev}" Fill="{StaticResource Fg}" Height="14" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="BtnPlay" Style="{StaticResource IconButton}" Width="44" Height="44" Margin="20,0" Click="Play_Click">
                                    <Path x:Name="PlayIcon" Data="{StaticResource GeoPlay}" Fill="{StaticResource Fg}" Width="20" Height="21" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="BtnNext" Style="{StaticResource IconButton}" Width="42" Height="40" Click="Next_Click">
                                    <Path Data="{StaticResource GeoNext}" Fill="{StaticResource Fg}" Height="14" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                            <c:PillSlider x:Name="MiniVolume" Tall="False" Width="112" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Volume" />
                            </Grid>
                        </StackPanel>

                        <!-- ===== Clipboard: an inset grouped list ===== -->
                        <Grid x:Name="PanelClip" Grid.Row="1" Margin="16,4,16,14" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid Margin="12,0,6,6">
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="RECENTLY COPIED" FontSize="10" FontWeight="Medium" />
                                <Button Style="{StaticResource TextButton}" HorizontalAlignment="Right" Content="Clear" Click="ClipClear_Click" />
                            </Grid>
                            <Border Grid.Row="1" Style="{StaticResource GlassCard}" CornerRadius="16">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                                        <ItemsControl x:Name="ClipList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="ClipItem_Click" Height="30" Padding="12,0,4,0"
                                                            BorderBrush="{StaticResource Separator}" BorderThickness="0,0,0,0.5">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#14FFFFFF" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Preview}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Style="{StaticResource IconButtonSmall}" Content="{Binding PinGlyph}"
                                                                    Tag="{Binding}" Click="ClipPin_Click" ToolTip="Pin" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="ClipEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource FgDim}" Text="Copy some text and it shows up here" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ===== Controls: a little Control Center ===== -->
                        <Grid x:Name="PanelControls" Grid.Row="1" Margin="16,2,16,14" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Connectivity -->
                            <Border Style="{StaticResource GlassCard}" CornerRadius="22" Height="140">
                                <UniformGrid Rows="2" Columns="2" Margin="8">
                                    <ToggleButton x:Name="TileWifi" Style="{StaticResource RoundToggle}" Background="{StaticResource Blue}" Content="&#xE701;" ToolTip="Wi-Fi" Click="Wifi_Click" />
                                    <ToggleButton x:Name="TileBt" Style="{StaticResource RoundToggle}" Background="{StaticResource Blue}" Content="&#xE702;" ToolTip="Bluetooth" Click="Bluetooth_Click" />
                                    <ToggleButton x:Name="TileMic" Style="{StaticResource RoundToggle}" Background="{StaticResource Orange}" ToolTip="Microphone" Click="Mic_Click">
                                        <TextBlock x:Name="TileMicIcon" Style="{StaticResource Icon}" Text="&#xE720;" />
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource RoundToggle}" Background="{StaticResource Orange}" Content="&#xE708;" ToolTip="Night light" Click="NightLight_Click" />
                                </UniformGrid>
                            </Border>

                            <!-- Modules -->
                            <Grid Grid.Column="2" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="10" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Button Style="{StaticResource SquareButton}" Click="Snip_Click" ToolTip="Screen snip">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A8;" FontSize="17" HorizontalAlignment="Center" />
                                        <TextBlock Text="Snip" FontFamily="{StaticResource UiFont}" FontSize="10.5" FontWeight="Medium" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="2" Style="{StaticResource SquareButton}" Click="Picker_Click" ToolTip="Ctrl+Alt+C">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" FontSize="17" HorizontalAlignment="Center" />
                                        <TextBlock Text="Colour" FontFamily="{StaticResource UiFont}" FontSize="10.5" FontWeight="Medium" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Brightness and volume -->
                            <Grid x:Name="BrightnessRow" Grid.Column="4">
                                <c:PillSlider x:Name="BrightnessSlider" Width="52" Height="140" Glyph="&#xE706;" IconClickable="False" ToolTip="Brightness" />
                            </Grid>
                            <Grid Grid.Column="6">
                                <c:PillSlider x:Name="VolumeSlider" Width="52" Height="140" ToolTip="Volume. Tap the speaker to mute." />
                            </Grid>
                        </Grid>

                        <!-- ===== System: activity rings ===== -->
                        <Grid x:Name="PanelSystem" Grid.Row="1" Margin="16,2,16,14" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GlassCard}" CornerRadius="22" Padding="14,11">
                                <Grid>
                                    <TextBlock Style="{StaticResource Caption}" FontWeight="Medium" Text="CPU" />
                                    <Grid Width="74" Height="74" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                                        <c:Ring x:Name="CpuRing" Thickness="8" Stroke="{StaticResource Green}" />
                                        <TextBlock x:Name="CpuText" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Text="–"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="UptimeText" Style="{StaticResource Caption}" FontSize="10.5" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource GlassCard}" CornerRadius="22" Padding="14,11">
                                <Grid>
                                    <TextBlock Style="{StaticResource Caption}" FontWeight="Medium" Text="Memory" />
                                    <Grid Width="74" Height="74" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                                        <c:Ring x:Name="RamRing" Thickness="8" Stroke="{StaticResource Blue}" />
                                        <TextBlock x:Name="RamText" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Text="–"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="RamDetail" Style="{StaticResource Caption}" FontSize="10.5" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource GlassCard}" CornerRadius="22" Padding="14,11">
                                <Grid>
                                    <TextBlock Style="{StaticResource Caption}" FontWeight="Medium" Text="Battery" />
                                    <Grid Width="74" Height="74" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                                        <c:Ring x:Name="BatRing" Thickness="8" Stroke="{StaticResource Green}" />
                                        <TextBlock x:Name="BatText" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Text="–"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="BatDetail" Style="{StaticResource Caption}" FontSize="10.5" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ===== Settings: inset grouped lists ===== -->
                        <Grid x:Name="PanelSettings" Grid.Row="1" Margin="16,2,16,10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource GlassCard}" CornerRadius="16" VerticalAlignment="Top">
                                <StackPanel>
                                    <Border Style="{StaticResource ListRow}">
                                        <Grid>
                                            <TextBlock Text="Shape" FontSize="12" VerticalAlignment="Center" />
                                            <Grid Width="128" Height="22" HorizontalAlignment="Right">
                                                <Border CornerRadius="7" Background="#3D767680" />
                                                <Border x:Name="SegThumb" Width="62" Margin="2" CornerRadius="5.5" HorizontalAlignment="Left" Background="#FF636366">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="SegThumbX" />
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.3" />
                                                    </Border.Effect>
                                                </Border>
                                                <UniformGrid Columns="2">
                                                    <RadioButton x:Name="StyleNotch" Style="{StaticResource SegmentButton}" GroupName="shape" Content="Notch" Checked="Shape_Checked" />
                                                    <RadioButton x:Name="StyleIsland" Style="{StaticResource SegmentButton}" GroupName="shape" Content="Island" Checked="Shape_Checked" />
                                                </UniformGrid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource ListRow}">
                                        <CheckBox x:Name="ChkHideHover" Style="{StaticResource Switch}" Content="Hide until hovered" Click="Setting_Click" />
                                    </Border>
                                    <Border Style="{StaticResource ListRow}">
                                        <CheckBox x:Name="ChkFullscreen" Style="{StaticResource Switch}" Content="Step aside in fullscreen" Click="Setting_Click" />
                                    </Border>
                                    <Border Style="{StaticResource ListRow}" BorderThickness="0">
                                        <CheckBox x:Name="ChkStartup" Style="{StaticResource Switch}" Content="Start with Windows" Click="Setting_Click" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource GlassCard}" CornerRadius="16" VerticalAlignment="Top">
                                <StackPanel>
                                    <Border Style="{StaticResource ListRow}">
                                        <CheckBox x:Name="ChkVisualizer" Style="{StaticResource Switch}" Content="Music visualizer" Click="Setting_Click" />
                                    </Border>
                                    <Border Style="{StaticResource ListRow}">
                                        <CheckBox x:Name="ChkTrackPeek" Style="{StaticResource Switch}" Content="Announce new songs" Click="Setting_Click" />
                                    </Border>
                                    <Border Style="{StaticResource ListRow}">
                                        <CheckBox x:Name="ChkClipPeek" Style="{StaticResource Switch}" Content="Announce copies" Click="Setting_Click" />
                                    </Border>
                                    <Border Style="{StaticResource ListRow}" BorderThickness="0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button Style="{StaticResource TextButton}" Foreground="{StaticResource Blue}" Content="All settings" Click="AllSettings_Click" />
                                                <Button Style="{StaticResource TextButton}" Foreground="{StaticResource Red}" Margin="14,0,0,0" Content="Quit" Click="Quit_Click" />
                                            </StackPanel>
                                            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Caption}" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                       Foreground="{StaticResource FgFaint}"
                                       Text="Ctrl+Alt+N open  ·  Ctrl+Alt+M mute mic  ·  Ctrl+Alt+C pick colour  ·  Ctrl+Alt+V clipboard" />
                        </Grid>
                    </Grid>
                </Canvas>

                <!-- ========== HERO LAYER: art, title, artist and waveform glide between closed and open ========== -->
                <Canvas x:Name="HeroLayer" IsHitTestVisible="False" Opacity="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Width="720" Height="300" UseLayoutRounding="False"
                        MouseLeftButtonDown="Hero_Down" MouseLeftButtonUp="Hero_Up" MouseLeave="Hero_Leave">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="HeroShift" />
                    </Canvas.RenderTransform>
                    <Border x:Name="HeroArt" Width="64" Height="64" CornerRadius="14" Background="#1AFFFFFF" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="HeroArtPress" />
                        </Border.RenderTransform>
                        <Grid>
                            <TextBlock x:Name="HeroPlaceholder" Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="22"
                                       Foreground="{StaticResource FgDim}" HorizontalAlignment="Center" />
                            <Border x:Name="HeroArtImage" CornerRadius="{Binding CornerRadius, ElementName=HeroArt}">
                                <Border.Background>
                                    <ImageBrush x:Name="HeroArtBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="{Binding CornerRadius, ElementName=HeroArt}" BorderThickness="1" BorderBrush="#22FFFFFF" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Text="Nothing playing">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="HeroTitleScale" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="HeroArtist" FontSize="12.5" Foreground="{StaticResource FgDim}"
                               TextTrimming="CharacterEllipsis" Text="Play something in any app">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="HeroArtistScale" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <c:Waveform x:Name="Viz" Width="34" Height="18" />
                </Canvas>
            </Grid>
        </Grid>
    </Grid>
</Window>
