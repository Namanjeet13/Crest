<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Crest</AssemblyName>
    <RootNamespace>Crest</RootNamespace>
    <Version>1.0.1</Version>
    <ApplicationIcon>Assets\Crest.ico</ApplicationIcon>
    <Company>Crest</Company>
    <Copyright>Crest contributors</Copyright>
    <Product>Crest</Product>
    <Description>A free, open-source Dynamic Island-style notch for Windows.</Description>
    <TieredPGO>false</TieredPGO>
    <!-- Lighter runtime footprint: a small UI app does not need a background GC thread,
         and only English resources ship. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Shaders/Glass.ps" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
