<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- iOS dark palette -->
    <SolidColorBrush x:Key="Fg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FgDim" Color="#99EBEBF5" />
    <SolidColorBrush x:Key="FgFaint" Color="#4DEBEBF5" />
    <SolidColorBrush x:Key="Separator" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="Green" Color="#30D158" />
    <SolidColorBrush x:Key="Orange" Color="#FF9F0A" />
    <SolidColorBrush x:Key="Red" Color="#FF453A" />
    <SolidColorBrush x:Key="Blue" Color="#0A84FF" />
    <!-- Accent follows the album art; replaced at runtime. -->
    <SolidColorBrush x:Key="Accent" Color="#0A84FF" />

    <!-- Liquid glass: clear fill, bright specular top edge, faint lower rim -->
    <SolidColorBrush x:Key="GlassFill" Color="#1AFFFFFF" />
    <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#59FFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="0.45" />
        <GradientStop Color="#0AFFFFFF" Offset="0.7" />
        <GradientStop Color="#26FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassDrop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#24FFFFFF" Offset="0.55" />
        <GradientStop Color="#30FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassDropRim" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#A6FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="0.5" />
        <GradientStop Color="#4DFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- iOS spring-like easings -->
    <ExponentialEase x:Key="EaseOut" EasingMode="EaseOut" Exponent="5" />
    <BackEase x:Key="EaseSpring" EasingMode="EaseOut" Amplitude="0.35" />

    <!-- ───── SF-style filled symbols (16×16 unless noted) ───── -->
    <GeometryGroup x:Key="IcoMusic" FillRule="Nonzero">
        <EllipseGeometry Center="4.3,12.6" RadiusX="2.7" RadiusY="2.2" />
        <EllipseGeometry Center="11.9,11" RadiusX="2.7" RadiusY="2.2" />
        <PathGeometry Figures="M5.7,12.6 L5.7,3.1 L14.6,1.1 L14.6,11 L13.2,11 L13.2,4.7 L7.1,6 L7.1,12.6 Z" />
    </GeometryGroup>
    <GeometryGroup x:Key="IcoClip" FillRule="EvenOdd">
        <RectangleGeometry Rect="2,2.2,12,13.4" RadiusX="2.2" RadiusY="2.2" />
        <RectangleGeometry Rect="5,0.6,6,3.4" RadiusX="1.3" RadiusY="1.3" />
        <RectangleGeometry Rect="4.8,7,6.4,1.4" RadiusX="0.7" RadiusY="0.7" />
        <RectangleGeometry Rect="4.8,10.4,4.4,1.4" RadiusX="0.7" RadiusY="0.7" />
    </GeometryGroup>
    <GeometryGroup x:Key="IcoControls" FillRule="EvenOdd">
        <RectangleGeometry Rect="0.5,1.4,15,6.2" RadiusX="3.1" RadiusY="3.1" />
        <EllipseGeometry Center="12.4,4.5" RadiusX="2.1" RadiusY="2.1" />
        <RectangleGeometry Rect="0.5,8.4,15,6.2" RadiusX="3.1" RadiusY="3.1" />
        <EllipseGeometry Center="3.6,11.5" RadiusX="2.1" RadiusY="2.1" />
    </GeometryGroup>
    <GeometryGroup x:Key="IcoStats" FillRule="Nonzero">
        <RectangleGeometry Rect="1,8.5,3.7,6.5" RadiusX="1.3" RadiusY="1.3" />
        <RectangleGeometry Rect="6.15,4.5,3.7,10.5" RadiusX="1.3" RadiusY="1.3" />
        <RectangleGeometry Rect="11.3,1,3.7,14" RadiusX="1.3" RadiusY="1.3" />
    </GeometryGroup>
    <GeometryGroup x:Key="IcoGear" FillRule="EvenOdd">
        <PathGeometry Figures="M6.03,2.44 L6.47,0.45 L9.53,0.45 L9.97,2.44 L10.54,2.68 L12.25,1.58 L14.42,3.75 L13.32,5.46 L13.56,6.03 L15.55,6.47 L15.55,9.53 L13.56,9.97 L13.32,10.54 L14.42,12.25 L12.25,14.42 L10.54,13.32 L9.97,13.56 L9.53,15.55 L6.47,15.55 L6.03,13.56 L5.46,13.32 L3.75,14.42 L1.58,12.25 L2.68,10.54 L2.44,9.97 L0.45,9.53 L0.45,6.47 L2.44,6.03 L2.68,5.46 L1.58,3.75 L3.75,1.58 L5.46,2.68 Z" />
        <EllipseGeometry Center="8,8" RadiusX="2.6" RadiusY="2.6" />
    </GeometryGroup>

    <!-- Transport (24×24) -->
    <PathGeometry x:Key="GeoPlay" Figures="M6.5,4.6 C6.5,3.5 7.6,2.9 8.5,3.4 L19.8,10.5 C20.7,11.1 20.7,12.9 19.8,13.5 L8.5,20.6 C7.6,21.1 6.5,20.5 6.5,19.4 Z" />
    <GeometryGroup x:Key="GeoPause">
        <RectangleGeometry Rect="5.5,3.5,4.6,17" RadiusX="1.4" RadiusY="1.4" />
        <RectangleGeometry Rect="13.9,3.5,4.6,17" RadiusX="1.4" RadiusY="1.4" />
    </GeometryGroup>
    <PathGeometry x:Key="GeoNext" Figures="M1.5,6.4 C1.5,5.6 2.4,5.1 3.1,5.6 L11.4,11.2 C12,11.6 12,12.4 11.4,12.8 L3.1,18.4 C2.4,18.9 1.5,18.4 1.5,17.6 Z M12,6.4 C12,5.6 12.9,5.1 13.6,5.6 L21.9,11.2 C22.5,11.6 22.5,12.4 21.9,12.8 L13.6,18.4 C12.9,18.9 12,18.4 12,17.6 Z" />
    <PathGeometry x:Key="GeoPrev" Figures="M22.5,6.4 C22.5,5.6 21.6,5.1 20.9,5.6 L12.6,11.2 C12,11.6 12,12.4 12.6,12.8 L20.9,18.4 C21.6,18.9 22.5,18.4 22.5,17.6 Z M12,6.4 C12,5.6 11.1,5.1 10.4,5.6 L2.1,11.2 C1.5,11.6 1.5,12.4 2.1,12.8 L10.4,18.4 C11.1,18.9 12,18.4 12,17.6 Z" />

    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <!-- Grouped-list row: hairline under every row but the last -->
    <Style x:Key="ListRow" TargetType="Border">
        <Setter Property="Height" Value="29" />
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="BorderBrush" Value="{StaticResource Separator}" />
        <Setter Property="BorderThickness" Value="0,0,0,0.5" />
    </Style>

    <!-- Glass tab: the droplet indicator behind it does the highlighting -->
    <Style x:Key="GlassTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#8CFFFFFF" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Sc" />
                        </Border.RenderTransform>
                        <Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Width="14" Height="14" Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Fg}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.84" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.84" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42" EasingFunction="{StaticResource EaseSpring}" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.42" EasingFunction="{StaticResource EaseSpring}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless icon button: soft pointer highlight, squish on press, springs back -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Sc" />
                        </Grid.RenderTransform>
                        <Border x:Name="Hl" CornerRadius="999" Background="#1FFFFFFF" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.82" Duration="0:0:0.14" EasingFunction="{StaticResource EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.82" Duration="0:0:0.14" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource EaseSpring}" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource EaseSpring}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButtonSmall" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource FgDim}" />
    </Style>

    <!-- iOS plain text button (tinted label) -->
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Blue}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="Cp" VerticalAlignment="Center" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Cp" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segment (the sliding thumb lives behind the buttons) -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Control Center round toggle -->
    <Style x:Key="RoundToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Sc" />
                        </Grid.RenderTransform>
                        <Ellipse Fill="#29FFFFFF" />
                        <Ellipse x:Name="On" Fill="{TemplateBinding Background}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.14" EasingFunction="{StaticResource EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.14" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource EaseSpring}" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource EaseSpring}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Control Center square module button -->
    <Style x:Key="SquareButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="20" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Sc" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.14" EasingFunction="{StaticResource EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.14" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource EaseSpring}" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource EaseSpring}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider parts -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin scrubber; thickens under the pointer like iOS -->
    <Style x:Key="ScrubSlider" TargetType="Slider">
        <Setter Property="Height" Value="16" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Grid x:Name="Bar" Height="5" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="BarSc" />
                            </Grid.RenderTransform>
                            <Grid.Clip>
                                <RectangleGeometry x:Name="BarClip" Rect="0,0,2000,5" RadiusX="2.5" RadiusY="2.5" />
                            </Grid.Clip>
                            <Border Background="#33FFFFFF" CornerRadius="2.5" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Background="#E6FFFFFF" Tag="2.5" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEmpty}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="0" Opacity="0" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BarSc" Storyboard.TargetProperty="ScaleY" To="1.8" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BarSc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- iOS switch: knob slides with a soft spring, track tints green -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Width="34" Height="21" VerticalAlignment="Center">
                            <Border CornerRadius="10.5" Background="#3D787880" />
                            <Border x:Name="OnTrack" CornerRadius="10.5" Background="{StaticResource Green}" Opacity="0" />
                            <Ellipse Width="17" Height="17" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobX" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="13" Duration="0:0:0.36" EasingFunction="{StaticResource EaseSpring}" />
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.36" EasingFunction="{StaticResource EaseSpring}" />
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgDim}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
